  "ar-nabra": {
    "display_name": "Nabra-82M Arabic",
    "repo_id": "oddadmix/Nabra-82M-v0.1",
    "revision": "main",
    "license": "Apache-2.0",
    "language": "ar",
    "sample_rate": 24000,
    "model": {
      "kind": "checkpoint",
      "path": "kokoro_arabic.pth",
