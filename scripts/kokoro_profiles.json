    "frontend": {
      "kind": "espeak",
      "name": "German IPA compatible frontend",
      "sherpa_text_compatible": false,
      "note": "Training used espeak-ng German IPA, while the publisher ships Crane's German G2P. Verify pykokoro G2P output before marking this profile automatic."
