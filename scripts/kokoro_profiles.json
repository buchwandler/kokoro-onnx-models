  "ar-nabra": {
    "display_name": "Nabra-82M Arabic",
    "repo_id": "marwanelamami/Nabra-82M-v0.1-ONNX",
    "revision": "85065b0be8573aefb401f8f53e7edc37d6556186",
    "license": "Apache-2.0",
    "language": "ar",
    "sample_rate": 24000,
    "model": {
      "kind": "onnx",
      "path": "nabra_fp32.onnx"
    },
    "voices": {
      "kind": "fixed_pt",
      "items": {
        "af_msa": "voices_af_msa.pt"
      }
    },
    "auxiliary_files": [
      {
        "path": "vocab.json",
        "output": "vocab.json",
        "role": "vocab",
        "format": "json"
      }
    ],
    "frontend": {
      "kind": "espeak_plus_preprocess",
      "name": "Arabic diacritizer + espeak-ng ar + Nabra cleanup",
      "sherpa_text_compatible": false,
      "note": "Nabra expects diacritized MSA and its model-specific G2P cleanup."
    },
    "release": {
      "enabled": true,
      "tag": "model-files-arabic-nabra-v0.1",
      "model_filename": "kokoro-arabic-nabra-v0.1.onnx",
      "voice_assets": [
        {
          "source": "voices.npz",
          "filename": "voices-arabic-nabra-v0.1.npz",
          "format": "numpy-npz"
        },
        {
          "source": "voices.raw.bin",
          "filename": "voices-arabic-nabra-v0.1.raw.bin",
          "format": "raw-float32-le"
        }
      ],
      "auxiliary_assets": [
        {
          "source": "vocab.json",
          "filename": "vocab-arabic-nabra-v0.1.json",
          "role": "vocab",
          "format": "json"
        }
      ]
    },
    "onnx_contract": {
      "inputs": {
        "input_ids": "int64",
        "ref_s": "float32",
        "speed": "float32"
      },
      "outputs": {
        "audio": "float32"
      },
      "max_tokens": 510
    }
  },
