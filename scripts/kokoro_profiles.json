{
  "vi-contextbox": {
    "display_name": "Kokoro Vietnamese (ContextBoxAI)",
    "repo_id": "contextboxai/Kokoro-Vietnamese",
    "revision": "main",
    "license": "Apache-2.0",
    "language": "vi",
    "sample_rate": 24000,
    "model": {
      "kind": "checkpoint",
      "path": "kokoro_vi.pth",
      "config": "config.json"
    },
    "voices": {
      "kind": "json_pt",
      "index": "voices.json"
    },
    "frontend": {
      "kind": "external",
      "name": "vig2p",
      "sherpa_text_compatible": false,
      "note": "Vietnamese training/inference uses vig2p; preserve that G2P behavior in pykokoro."
    },
    "release": {
      "enabled": true,
      "tag": "model-files-vietnamese-v1.0",
      "model_filename": "kokoro-vietnamese-v1.0.onnx",
      "voices_filename": "voices-vietnamese-v1.0.bin",
      "config_filename": "config-vietnamese-v1.0.json",
      "voice_assets": [
        {
          "source": "voices.npz",
          "filename": "voices-vietnamese-v1.0.npz",
          "format": "numpy-npz"
        },
        {
          "source": "voices.raw.bin",
          "filename": "voices-vietnamese-v1.0.raw.bin",
          "format": "raw-float32-le"
        }
      ]
    },
    "onnx_contract": {
      "inputs": {
        "tokens": "int64",
        "style": "float32",
        "speed": "float32"
      }
    }
  },
