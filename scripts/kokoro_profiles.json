        {
          "source": "voices.raw.bin",
          "filename": "voices-german-kerstin-v1.0.raw.bin",
          "format": "raw-float32-le"
        }
      ]
    },
    "onnx_contract": {
      "inputs": {
        "input_ids": "int64",
        "style": "float32",
        "speed": "float32"
