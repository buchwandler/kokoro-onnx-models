{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchwandler/kokoro-onnx-models/schemas/release-manifest.schema.json",
  "title": "Kokoro ONNX release manifest",
  "type": "object",
  "required": [
    "schema",
    "runtime_contract",
    "repository",
    "tag",
    "profile",
    "model_version",
    "generated_at",
    "source",
    "license",
    "publication",
    "runtime",
    "onnx_contract",
    "assets"
  ],
  "properties": {
    "schema": { "const": 2 },
    "runtime_contract": { "const": 1 },
    "repository": { "const": "buchwandler/kokoro-onnx-models" },
    "tag": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "release_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "builder": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "repository", "revision"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_artifacts": { "type": "object" },
        "exporter": { "type": "object" }
      },
      "additionalProperties": true
    },
    "license": { "type": "string", "minLength": 1 },
    "publication": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": [
        "language_codes",
        "sample_rate",
        "frontend",
        "frontend_experimental",
        "max_tokens"
      ],
      "properties": {
        "language_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "frontend": { "type": "string", "minLength": 1 },
        "frontend_experimental": { "type": "boolean" },
        "tokenizer_vocab_version": { "type": "string", "minLength": 1 },
        "vocabulary_source": { "type": "string", "minLength": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "voice_mode": { "enum": ["static", "reference"] },
        "layout": {
          "enum": ["single-onnx-v1", "split-onnx-v1", "cloning-onnx-v1"]
        },
        "speed_supported": { "type": "boolean" },
        "style_dimensions": { "$ref": "#/$defs/style_dimensions" },
        "reference": { "$ref": "#/$defs/reference" },
        "default_voice": { "type": "string", "minLength": 1 },
        "voices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "voice_enrollers": {
          "type": "array",
          "items": { "$ref": "#/$defs/enroller" }
        },
        "voice_metadata": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/voice_metadata" }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "voice_mode": { "const": "reference" } },
            "required": ["voice_mode"]
          },
          "then": {
            "required": [
              "layout",
              "speed_supported",
              "style_dimensions",
              "reference"
            ],
            "properties": {
              "default_voice": false,
              "voices": { "maxItems": 0 },
              "voice_metadata": false
            }
          },
          "else": {
            "required": ["default_voice", "voices"],
            "properties": { "voices": { "minItems": 1 } }
          }
        }
      ]
    },
    "onnx_contract": {
      "type": "object",
      "required": ["inputs", "outputs", "max_tokens"],
      "properties": {
        "inputs": { "type": "object", "minProperties": 1 },
        "outputs": { "type": "object", "minProperties": 1 },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["inputs", "outputs"],
            "properties": {
              "inputs": {},
              "outputs": {}
            },
            "additionalProperties": true
          }
        },
        "timing": { "$ref": "#/$defs/timing" },
        "max_tokens": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "required": [
        "kind",
        "output",
        "unit",
        "samples_per_frame",
        "includes_boundary_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "token-duration-v1" },
        "output": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "unit": { "const": "frame" },
        "samples_per_frame": { "type": "integer", "exclusiveMinimum": 0 },
        "includes_boundary_tokens": { "type": "boolean" }
      }
    },
    "transform": {
      "type": "object",
      "required": ["type", "version", "source_manifest"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "source_manifest": { "type": "string", "minLength": 1 },
        "assets": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "format", "size", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": {
            "enum": [
              "model",
              "voices",
              "config",
              "vocab",
              "bundle",
              "metadata",
              "license",
              "attribution"
            ]
          },
          "quality": { "type": "string", "minLength": 1 },
          "component": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "handling": { "type": "object", "additionalProperties": true },
          "provenance": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "role": { "const": "model" } } },
            "then": { "required": ["quality"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "style_dimensions": {
      "type": "object",
      "required": ["acoustic", "duration"],
      "additionalProperties": false,
      "properties": {
        "acoustic": { "type": "integer", "minimum": 1 },
        "duration": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "format",
        "sample_rate",
        "identity_sample_rate",
        "min_seconds",
        "max_seconds",
        "memory_width",
        "style_width"
      ],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "akinvox-cloning-reference-v1" },
        "sample_rate": { "const": 24000 },
        "identity_sample_rate": { "const": 16000 },
        "min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "memory_width": { "type": "integer", "minimum": 1 },
        "style_width": { "type": "integer", "minimum": 1 }
      }
    },
    "enroller": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "input",
        "transcript_required",
        "min_seconds",
        "recommended_seconds",
        "max_seconds",
        "output",
        "model_component",
        "metadata_component"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "transcript_required": { "type": "boolean" },
        "min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "recommended_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "output": { "$ref": "#/$defs/enroller_output" },
        "model_component": { "type": "string", "minLength": 1 },
        "metadata_component": { "type": "string", "minLength": 1 }
      }
    },
    "enroller_output": {
      "type": "object",
      "required": ["format", "shape", "dtype"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "kokoro-voicepack-v1" },
        "shape": { "const": [510, 1, 256] },
        "dtype": { "const": "float32" }
      }
    },
    "voice_metadata": {
      "type": "object",
      "required": ["gender", "language", "locale", "language_label"],
      "additionalProperties": false,
      "properties": {
        "gender": { "enum": ["female", "male", "neutral", "unknown"] },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,4})?$"
        },
        "language_label": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false
}
