{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchwandler/kokoro-onnx-models/schemas/release-manifest.schema.json",
  "title": "Kokoro ONNX release manifest",
  "type": "object",
  "required": ["schema", "repository", "tag", "license", "assets"],
  "properties": {
    "schema": {"const": 1},
    "repository": {"type": "string"},
    "tag": {"type": "string"},
    "profile": {"type": ["string", "null"]},
    "source": {"type": "object"},
    "license": {"type": "string"},
    "language": {"type": ["string", "null"]},
    "frontend": {"type": ["object", "null"]},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
