{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchwandler/kokoro-onnx-models/schemas/model-registry.schema.json",
  "title": "Kokoro runtime model registry",
  "type": "object",
  "required": ["schema", "runtime_contract", "models"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "runtime_contract": { "const": 1 },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "model_version",
        "language_codes",
        "frontend",
        "sample_rate",
        "runtime",
        "onnx_contract",
        "license",
        "mirror_policy",
        "distributions"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "runtime_available": { "type": "boolean" },
        "language_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[a-z]{2,4})?$"
          },
          "uniqueItems": true
        },
        "frontend": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"
        },
        "frontend_display_name": { "type": "string", "minLength": 1 },
        "sample_rate": { "const": 24000 },
        "runtime": { "$ref": "#/$defs/runtime" },
        "onnx_contract": { "$ref": "#/$defs/contract" },
        "license": { "$ref": "#/$defs/license" },
        "mirror_policy": {
          "enum": ["required", "preferred", "optional", "forbidden"]
        },
        "distributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/distribution" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["layout", "max_tokens"],
      "additionalProperties": false,
      "properties": {
        "layout": {
          "enum": ["single-onnx-v1", "split-onnx-v1", "cloning-onnx-v1"]
        },
        "voice_mode": { "enum": ["static", "reference"] },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "default_voice": { "type": "string", "minLength": 1 },
        "voices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "voice_metadata": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/voice_metadata" }
        },
        "speed_supported": { "type": "boolean" },
        "style_dimensions": { "$ref": "#/$defs/style_dimensions" },
        "reference": { "$ref": "#/$defs/reference" },
        "voice_enrollers": {
          "type": "array",
          "items": { "$ref": "#/$defs/enroller" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "voice_mode": { "const": "reference" } },
            "required": ["voice_mode"]
          },
          "then": {
            "required": ["speed_supported", "style_dimensions", "reference"],
            "properties": {
              "default_voice": false,
              "voices": { "maxItems": 0 },
              "voice_metadata": false
            }
          },
          "else": {
            "required": ["default_voice", "voices"],
            "properties": { "voices": { "minItems": 1 } }
          }
        }
      ]
    },
    "style_dimensions": {
      "type": "object",
      "required": ["acoustic", "duration"],
      "additionalProperties": false,
      "properties": {
        "acoustic": { "type": "integer", "minimum": 1 },
        "duration": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "format",
        "sample_rate",
        "identity_sample_rate",
        "min_seconds",
        "max_seconds",
        "memory_width",
        "style_width"
      ],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "akinvox-cloning-reference-v1" },
        "sample_rate": { "const": 24000 },
        "identity_sample_rate": { "const": 16000 },
        "min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "memory_width": { "type": "integer", "minimum": 1 },
        "style_width": { "type": "integer", "minimum": 1 }
      }
    },
    "voice_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gender", "language", "locale", "language_label"],
      "properties": {
        "gender": { "enum": ["female", "male", "neutral", "unknown"] },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z]{2,4})?$"
        },
        "language_label": { "type": "string", "minLength": 1 },
        "description_key": { "type": "string", "minLength": 1 }
      }
    },
    "enroller": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "input",
        "transcript_required",
        "min_seconds",
        "recommended_seconds",
        "max_seconds",
        "output",
        "model_component",
        "metadata_component"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "input": { "type": "string", "minLength": 1 },
        "transcript_required": { "type": "boolean" },
        "min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "recommended_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "output": { "$ref": "#/$defs/enroller_output" },
        "model_component": { "type": "string", "minLength": 1 },
        "metadata_component": { "type": "string", "minLength": 1 }
      }
    },
    "enroller_output": {
      "type": "object",
      "required": ["format", "shape", "dtype"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "kokoro-voicepack-v1" },
        "shape": { "const": [510, 1, 256] },
        "dtype": { "const": "float32" }
      }
    },
    "contract": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "additionalProperties": true,
      "properties": {
        "inputs": { "$ref": "#/$defs/tensor_map" },
        "outputs": { "$ref": "#/$defs/tensor_map" },
        "components": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/contract" }
        },
        "timing": { "$ref": "#/$defs/timing" },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "tensor_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "timing": {
      "type": "object",
      "required": [
        "kind",
        "output",
        "unit",
        "samples_per_frame",
        "includes_boundary_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "token-duration-v1" },
        "output": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "unit": { "const": "frame" },
        "samples_per_frame": { "type": "integer", "exclusiveMinimum": 0 },
        "includes_boundary_tokens": { "type": "boolean" }
      }
    },
    "license": {
      "type": "object",
      "required": ["declared", "redistribution"],
      "additionalProperties": false,
      "properties": {
        "declared": { "type": "string", "minLength": 1 },
        "redistribution": { "type": "string", "minLength": 1 },
        "source_repository": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["id", "provider", "transport", "runtime_ready", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "provider": { "enum": ["huggingface", "github-release"] },
        "transport": { "const": "https" },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "release_key": { "type": "string", "minLength": 1 },
        "release_tag": { "type": "string", "minLength": 1 },
        "release_version": { "type": "integer", "minimum": 1 },
        "runtime_ready": { "const": true },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": { "const": "github-release" }
            }
          },
          "then": {
            "required": ["release_key", "release_tag", "release_version"]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "role",
        "url",
        "local_name",
        "format",
        "size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "model",
            "voice",
            "voices",
            "config",
            "vocab",
            "metadata",
            "bundle",
            "license",
            "attribution"
          ]
        },
        "quality": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "local_name": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "exclusiveMinimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "handling": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
