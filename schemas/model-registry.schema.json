{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buchwandler/kokoro-onnx-models/schemas/model-registry.schema.json",
  "title": "Kokoro runtime model registry",
  "type": "object",
  "required": ["schema", "runtime_contract", "models"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "runtime_contract": { "const": 1 },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "model_version",
        "language_codes",
        "frontend",
        "sample_rate",
        "runtime",
        "onnx_contract",
        "license",
        "mirror_policy",
        "distributions"
      ],
      "additionalProperties": false,
      "properties": {
        "model_version": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "runtime_available": { "type": "boolean" },
        "language_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[a-z]{2,4})?$"
          },
          "uniqueItems": true
        },
        "frontend": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"
        },
        "frontend_display_name": { "type": "string", "minLength": 1 },
        "sample_rate": { "const": 24000 },
        "runtime": { "$ref": "#/$defs/runtime" },
        "onnx_contract": { "$ref": "#/$defs/contract" },
        "license": { "$ref": "#/$defs/license" },
        "mirror_policy": {
          "enum": ["required", "preferred", "optional", "forbidden"]
        },
        "distributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/distribution" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["layout", "max_tokens", "default_voice", "voices"],
      "additionalProperties": false,
      "properties": {
        "layout": { "enum": ["single-onnx-v1", "split-onnx-v1"] },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "default_voice": { "type": "string", "minLength": 1 },
        "voices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "additionalProperties": true,
      "properties": {
        "inputs": { "$ref": "#/$defs/tensor_map" },
        "outputs": { "$ref": "#/$defs/tensor_map" },
        "components": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/contract" }
        },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "tensor_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "license": {
      "type": "object",
      "required": ["declared", "redistribution"],
      "additionalProperties": false,
      "properties": {
        "declared": { "type": "string", "minLength": 1 },
        "redistribution": { "type": "string", "minLength": 1 },
        "source_repository": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["id", "provider", "transport", "runtime_ready", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "provider": { "enum": ["huggingface", "github-release"] },
        "transport": { "const": "https" },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "release_key": { "type": "string", "minLength": 1 },
        "release_tag": { "type": "string", "minLength": 1 },
        "runtime_ready": { "const": true },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "role",
        "url",
        "local_name",
        "format",
        "size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "model",
            "voice",
            "voices",
            "config",
            "vocab",
            "metadata",
            "bundle",
            "license",
            "attribution"
          ]
        },
        "quality": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "local_name": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "exclusiveMinimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "handling": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
